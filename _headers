# Cloudflare Pages / Netlify header rules.
# NOTE: GitHub Pages ignores this file — it has no mechanism for custom headers.
# 'unsafe-inline' is required because the pages carry inline <style> and <script>
# by design (the tools must stay self-contained).
#
# connect-src and form-action allow api.web3forms.com — the contact form posts
# there and it relays to Allan's inbox. Nothing else outbound is permitted.
# If the form backend ever changes, update BOTH directives.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'; object-src 'none'

# Assets use stable filenames (site.css, allan-dones.jpg) rather than
# content-hashed ones, so they must NOT be cached immutably — an edit would
# never reach anyone who already holds a cached copy.
#
# max-age=300 + must-revalidate: browsers revalidate after 5 minutes and
# Cloudflare answers with a 304 when unchanged, so the bandwidth saving is
# retained without the staleness trap.
#
# If assets are ever content-hashed (site.a3f9c1.css), restore:
#   Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=300, must-revalidate

# Credential documents are immutable once issued and are referenced by stable
# filenames, so they can be cached far harder than /assets/*.
/credentials/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
